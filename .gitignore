*.mp4

# Local/editor files
.vscode/
.idea/
*.tmp
WhatsApp Video*.mp4
WhatsApp Image*.jpeg
!assets/logo/majestic_gems_icon_source_v1.jpeg

# Local real-gameplay capture runs and their engine logs are review artifacts.
reports/*.log
reports/**/*.log
reports/input-replay-gameplay-*/
reports/real-gameplay-screenshots-*/
reports/all-gameplay-screenshots-by-level-*/
scripts/dev/capture_input_replay_gameplay_v1.gd
